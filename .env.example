# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com credenciais reais.

# MySQL
DB_HOST=seu_host
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_NAME=seu_banco
DB_PORT=3306

# Admin (painel administrativo)
LOGIN_USER=seu_usuario_admin
LOGIN_PASS=sua_senha_admin

# Mercado Pago
MP_PUBLIC_KEY=sua_public_key
MP_ACCESS_TOKEN=seu_access_token
MP_CLIENT_ID=seu_client_id
MP_CLIENT_SECRET=seu_client_secret

# URL base (em produção: https://www.seudominio.com.br)
BASE_URL=http://localhost:3000

# Brevo (e-mails transacionais)
BREVO_API_KEY=sua_chave_brevo
BREVO_FROM_EMAIL=nao-responda@seudominio.com.br
BREVO_FROM_NAME=Office Express

# Sessão
SESSION_SECRET=uma_string_aleatoria_segura
# Defina como "true" quando usar HTTPS em produção
COOKIE_SECURE=false

# IA — Análise de currículo (Google Gemini)
# Deixe vazio para desativar e usar o parser local como fallback.
# Obtenha uma chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
